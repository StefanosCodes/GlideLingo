# Local authoring configuration only. Runtime clients never receive these values.
GOOGLE_CLOUD_PROJECT=your-glidelingo-project-id
GOOGLE_TTS_DEFAULT_LOCALE=el-GR
GOOGLE_TTS_DEFAULT_VOICE=el-GR-Chirp3-HD-Aoede
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_MAX_GENERATION_USD=5.00

# Public client configuration. Physical devices need a LAN or tunnel URL that
# they can reach, for example http://192.168.1.20:8123.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8123
EXPO_PUBLIC_LESSON_TUTOR_ENABLED=false

# Clerk's publishable client key. This value is safe for the app bundle; never
# add a Clerk secret key to an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# RevenueCat public SDK keys. The Test Store key is used only in development.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_your_test_store_key
# Mock access is available only when this explicit flag is true in development.
# Never set it in preview or production release environments.
EXPO_PUBLIC_ENABLE_MOCK_BILLING=true
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_public_sdk_key
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_public_sdk_key
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_your_web_public_sdk_key

# FastAPI settings. The committed values are local-development examples only.
GLIDELINGO_DATABASE_URL=postgresql+psycopg://glidelingo:glidelingo_dev_only@localhost:55433/glidelingo
GLIDELINGO_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","glidelingo://app"]
GLIDELINGO_LESSON_TUTOR_ENABLED=false
GLIDELINGO_LESSON_TUTOR_SERVICE_URL=https://private-tutor.example.run.app
GLIDELINGO_LESSON_TUTOR_SERVICE_AUDIENCE=https://private-tutor.example.run.app
GLIDELINGO_LESSON_TUTOR_SERVICE_TIMEOUT_SECONDS=6
GLIDELINGO_LESSON_TUTOR_OPERATION_DEADLINE_SECONDS=11
# Generate at least 32 random bytes. Never reuse this value across environments.
GLIDELINGO_LESSON_TUTOR_PSEUDONYM_KEY=
GLIDELINGO_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
GLIDELINGO_CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
GLIDELINGO_CLERK_AUTHORIZED_PARTIES=["http://localhost:8081","http://127.0.0.1:8081","glidelingo://app"]
# Optional defense-in-depth when the client requests a Clerk JWT template with
# the same audience value.
# GLIDELINGO_CLERK_AUDIENCE=glidelingo-api

# IAM-private tutor process. Keep disabled until every activation gate is complete.
GLIDELINGO_TUTOR_ENABLED=false
GLIDELINGO_TUTOR_OPENAI_MODEL=gpt-5.6-terra
GLIDELINGO_TUTOR_MODEL_DEADLINE_SECONDS=4
GLIDELINGO_TUTOR_SERVICE_DEADLINE_SECONDS=5
OPENAI_API_KEY=

# Docker Compose settings.
GLIDELINGO_DB_PORT=55433
GLIDELINGO_DB_PASSWORD=glidelingo_dev_only
