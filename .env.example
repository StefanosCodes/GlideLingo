# Local authoring configuration only. Runtime clients never receive these values.
GOOGLE_CLOUD_PROJECT=your-glidelingo-project-id
GOOGLE_TTS_DEFAULT_LOCALE=el-GR
GOOGLE_TTS_DEFAULT_VOICE=el-GR-Chirp3-HD-Aoede
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_MAX_GENERATION_USD=5.00

# Public client configuration. Physical devices need a LAN or tunnel URL that
# they can reach, for example http://192.168.1.20:8123.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8123
EXPO_PUBLIC_LESSON_TUTOR_ENABLED=false
EXPO_PUBLIC_AFFILIATE_REFERRALS_ENABLED=false

# Website and Cloudflare referral entrypoints are independently disabled.
PUBLIC_AFFILIATE_REFERRALS_ENABLED=false
AFFILIATE_REFERRAL_ENABLED=false
# PUBLIC_REFERRAL_APP_URL=https://app.glidelingo.com/referral
# GLIDELINGO_API_BASE_URL=https://api.example.com

# Clerk's publishable client key. This value is safe for the app bundle; never
# add a Clerk secret key to an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# RevenueCat public SDK keys. The Test Store key is used only for the separate
# Test Store development path; it does not exercise RevenueCat Billing or Stripe.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_your_test_store_key
# Mock access is available only when this explicit flag is true in development.
# Never set it in preview or production release environments.
EXPO_PUBLIC_ENABLE_MOCK_BILLING=true
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_public_sdk_key
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_public_sdk_key
# A dedicated RevenueCat Billing configuration connected to a Stripe sandbox has
# its own Web public SDK key (expected `rcb_...`).
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_your_stripe_sandbox_web_public_sdk_key

# Server-owned RevenueCat authorization. Keep disabled until migration 002,
# webhook delivery, retention maintenance, and sandbox acceptance are complete.
# Use the app public SDK key for RevenueCat's read-only v1 Customer Info endpoint.
# For desktop Stripe-sandbox acceptance, this must be the exact same Web public SDK
# key used by EXPO_PUBLIC_REVENUECAT_WEB_API_KEY from the dedicated sandbox Billing
# configuration (expected `rcb_...`). Use `test_...` only for the separate Test
# Store path. Production uses its own matching live Billing configuration and key.
# Never use a project-wide `sk_...` secret key. The other values below are server
# secrets; never prefix them with EXPO_PUBLIC_.
GLIDELINGO_REVENUECAT_ENABLED=false
GLIDELINGO_REVENUECAT_ENVIRONMENT=SANDBOX
GLIDELINGO_REVENUECAT_API_KEY=rcb_your_stripe_sandbox_web_public_sdk_key
# Public app/configuration identifier included in signed RevenueCat events. The
# durable intake flag refuses events for any other app context.
GLIDELINGO_REVENUECAT_WEBHOOK_APP_ID=
# Generate an environment-specific value of at least 32 random bytes.
GLIDELINGO_REVENUECAT_PSEUDONYM_KEY=
# Generate an independent high-entropy Authorization value and configure the
# exact same value on the RevenueCat webhook integration.
GLIDELINGO_REVENUECAT_WEBHOOK_AUTHORIZATION=
# Copy the one-time HMAC signing secret issued by RevenueCat for the webhook.
GLIDELINGO_REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Durable intake and its worker remain independently disabled. Migration 005
# and worker acceptance must pass before enabling this flag in any environment.
GLIDELINGO_BILLING_EVENT_INTAKE_ENABLED=false
# Migration 007, an explicitly activated versioned policy, and a future
# authenticated Stripe financial-fact boundary are required before enabling.
GLIDELINGO_AFFILIATE_COMMISSIONS_ENABLED=false
# Optional bounded defaults:
# GLIDELINGO_REVENUECAT_API_TIMEOUT_SECONDS=2.5
# GLIDELINGO_REVENUECAT_ENTITLEMENT_FRESHNESS_SECONDS=900
# GLIDELINGO_REVENUECAT_WEBHOOK_MAX_BODY_BYTES=65536
# GLIDELINGO_REVENUECAT_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
# GLIDELINGO_BILLING_EVENT_WORKER_POLL_SECONDS=1
# GLIDELINGO_BILLING_EVENT_WORKER_LEASE_SECONDS=30
# GLIDELINGO_BILLING_EVENT_WORKER_MAXIMUM_ATTEMPTS=8
# GLIDELINGO_BILLING_EVENT_WORKER_RETRY_BASE_SECONDS=5
# GLIDELINGO_BILLING_EVENT_WORKER_RETRY_MAX_SECONDS=3600

# FastAPI settings. The committed values are local-development examples only.
GLIDELINGO_DATABASE_URL=postgresql+psycopg://glidelingo:glidelingo_dev_only@localhost:55433/glidelingo
GLIDELINGO_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
GLIDELINGO_LESSON_TUTOR_ENABLED=false
GLIDELINGO_LESSON_TUTOR_SERVICE_URL=https://private-tutor.example.run.app
GLIDELINGO_LESSON_TUTOR_SERVICE_AUDIENCE=https://private-tutor.example.run.app
GLIDELINGO_LESSON_TUTOR_SERVICE_TIMEOUT_SECONDS=6
GLIDELINGO_LESSON_TUTOR_OPERATION_DEADLINE_SECONDS=11
# Generate at least 32 random bytes. Never reuse this value across environments.
GLIDELINGO_LESSON_TUTOR_PSEUDONYM_KEY=
# Affiliate identity, handoff, attribution, administration, and ledger reads
# remain independently closed until every documented activation gate passes.
GLIDELINGO_AFFILIATES_ENABLED=false
GLIDELINGO_AFFILIATE_REFERRAL_RESOLUTION_ENABLED=false
GLIDELINGO_AFFILIATE_ATTRIBUTION_BINDING_ENABLED=false
GLIDELINGO_AFFILIATE_MEMBERSHIP_ADMIN_ENABLED=false
GLIDELINGO_AFFILIATE_PRINCIPAL_PSEUDONYM_KEY=
GLIDELINGO_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
GLIDELINGO_CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
GLIDELINGO_CLERK_AUTHORIZED_PARTIES=["http://localhost:8081","http://127.0.0.1:8081"]
# Optional defense-in-depth when the client requests a Clerk JWT template with
# the same audience value.
# GLIDELINGO_CLERK_AUDIENCE=glidelingo-api

# IAM-private tutor process. Keep disabled until every activation gate is complete.
GLIDELINGO_TUTOR_ENABLED=false
GLIDELINGO_TUTOR_OPENAI_MODEL=gpt-5.6-terra
GLIDELINGO_TUTOR_MODEL_DEADLINE_SECONDS=4
GLIDELINGO_TUTOR_SERVICE_DEADLINE_SECONDS=5
OPENAI_API_KEY=

# Docker Compose settings.
GLIDELINGO_DB_PORT=55433
GLIDELINGO_DB_PASSWORD=glidelingo_dev_only
