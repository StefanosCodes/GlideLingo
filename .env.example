# Local authoring configuration only. Runtime clients never receive these values.
GOOGLE_CLOUD_PROJECT=your-glidelingo-project-id
GOOGLE_TTS_DEFAULT_LOCALE=el-GR
GOOGLE_TTS_DEFAULT_VOICE=el-GR-Chirp3-HD-Aoede
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_MAX_GENERATION_USD=5.00

# Public client configuration. Physical devices need a LAN or tunnel URL that
# they can reach, for example http://192.168.1.20:8123.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8123

# FastAPI settings. The committed values are local-development examples only.
GLIDELINGO_DATABASE_URL=postgresql+psycopg://glidelingo:glidelingo_dev_only@localhost:55433/glidelingo
GLIDELINGO_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]

# Docker Compose settings.
GLIDELINGO_DB_PORT=55433
GLIDELINGO_DB_PASSWORD=glidelingo_dev_only
