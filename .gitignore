# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
backend/.venv/
backend/.mypy_cache/
backend/.pytest_cache/
backend/.ruff_cache/
__pycache__/
*.py[cod]

# Expo
.expo/
dist/
release/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (keep secrets out of Git)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# Terraform local state and working directories
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

example

# generated native folders
/ios
/android
