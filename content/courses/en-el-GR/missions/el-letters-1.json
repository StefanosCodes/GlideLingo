{
  "schemaVersion": 1,
  "lessonId": "el-letters-1",
  "lessonTitle": "The Greek sound map",
  "moduleTitle": "First sounds",
  "objective": "Recognize α, ε, and ι and use their sounds to read a simple Greek syllable.",
  "capability": {
    "id": "el-script-vowels-a-e-i",
    "canDo": "I can recognize α, ε, and ι in a new Greek syllable.",
    "mode": "reading"
  },
  "introducedModes": ["listening", "reading"],
  "blocks": [
    {
      "type": "heading",
      "text": "Greek is spoken more regularly than it looks"
    },
    {
      "type": "prose",
      "text": "Modern Greek writing looks new if you grew up with Latin letters. The sounds do not. Most letters keep one stable sound. Learn those first and the alphabet becomes a map, not a puzzle."
    },
    {
      "type": "prose",
      "text": "This sitting is only listening with your eyes. Say each example aloud. You do not need to write yet."
    },
    {
      "type": "heading",
      "text": "Three vowels to hold"
    },
    {
      "type": "example",
      "greek": "α · Α",
      "gloss": "like the a in father",
      "audioId": "el-letter-alpha"
    },
    {
      "type": "example",
      "greek": "ε · Ε",
      "gloss": "like the e in red",
      "audioId": "el-letter-epsilon"
    },
    {
      "type": "example",
      "greek": "ι · Ι",
      "gloss": "like the ee in see",
      "audioId": "el-letter-iota"
    },
    {
      "type": "callout",
      "text": "η and υ also sound like ι in Standard Modern Greek. Treat them as the same sound for now."
    },
    {
      "type": "heading",
      "text": "Hear it in a word"
    },
    {
      "type": "example",
      "greek": "καλημέρα",
      "gloss": "kalimera — good morning",
      "audioId": "el-kalimera"
    },
    {
      "type": "example",
      "greek": "νερό",
      "gloss": "nero — water",
      "audioId": "el-nero"
    },
    {
      "type": "listen",
      "label": "The three vowels, then καλημέρα",
      "audioId": "el-vowels-kalimera"
    },
    {
      "type": "check",
      "prompt": "Which letter sounds like the a in father?",
      "choices": ["α", "ε", "ι"],
      "answer": "α"
    }
  ],
  "beats": [
    {
      "type": "hear",
      "greek": "α · Α",
      "gloss": "like the a in father",
      "audioId": "el-letter-alpha"
    },
    {
      "type": "hear",
      "greek": "ε · Ε",
      "gloss": "like the e in red",
      "audioId": "el-letter-epsilon"
    },
    {
      "type": "hear",
      "greek": "ι · Ι",
      "gloss": "like the ee in see",
      "audioId": "el-letter-iota"
    },
    {
      "type": "notice",
      "text": "η and υ also sound like ι in Standard Modern Greek. Same sound, different letters. Treat them as one for now."
    },
    {
      "type": "hear",
      "greek": "καλημέρα",
      "gloss": "kalimera — good morning",
      "audioId": "el-kalimera"
    },
    {
      "type": "check",
      "prompt": "Which letter is the a in father?",
      "choices": ["α", "ε", "ι"],
      "answer": "α",
      "feedback": "α carries the open a sound in father. Compare it with ε (e) and ι (ee).",
      "evidence": {
        "capabilityId": "el-script-vowels-a-e-i",
        "level": "practice"
      }
    },
    {
      "type": "check",
      "prompt": "What sound does this make?",
      "greek": "να",
      "choices": ["ma", "na", "ne"],
      "answer": "na",
      "feedback": "ν is n and α is a, so να reads na.",
      "evidence": {
        "capabilityId": "el-script-vowels-a-e-i",
        "level": "checkpoint"
      }
    }
  ],
  "reviewBeats": [
    {
      "type": "notice",
      "text": "No model this time. Read the new syllable from the sound pattern you practiced."
    },
    {
      "type": "check",
      "prompt": "Read this new syllable",
      "greek": "με",
      "choices": ["ma", "me", "mi"],
      "answer": "me",
      "feedback": "μ is m and ε is e, so με reads me.",
      "evidence": {
        "capabilityId": "el-script-vowels-a-e-i",
        "level": "checkpoint"
      }
    }
  ]
}
