{
  "schemaVersion": 1,
  "id": "portable-request-mission",
  "version": "1.0.0",
  "courseId": "en-x-glide-portability",
  "moduleId": "portable-first-contact",
  "title": "Make a fixture request",
  "realWorldJob": "Use an invented phrase to request an invented item in a bounded test.",
  "learnerRole": "Fixture learner",
  "otherRoles": ["Fixture attendant"],
  "targetCapabilityIds": ["portable-request-item"],
  "supportingCapabilityIds": [],
  "prerequisiteCapabilityIds": [],
  "completionCondition": {
    "type": "all-required-activities",
    "requiredActivityIds": [
      "portable-context",
      "portable-symbol-choice",
      "portable-recall",
      "portable-build-request",
      "portable-roleplay",
      "portable-checkpoint"
    ]
  },
  "lessonOrder": ["portable-request-lesson"],
  "lessons": [
    {
      "schemaVersion": 1,
      "id": "portable-request-lesson",
      "version": "1.0.0",
      "missionId": "portable-request-mission",
      "title": "Build one fictional request",
      "immediateOutcome": "Recognize, retrieve, and use the authored fixture request.",
      "primaryLearnerAction": "Construct the request sipa na.",
      "entryState": "No fixture-language knowledge",
      "durationMinutes": 5,
      "activities": [
        {
          "schemaVersion": 1,
          "id": "portable-context",
          "version": "1.0.0",
          "rendererType": "explain",
          "phase": "encounter",
          "instruction": "Read the bounded fixture context.",
          "prompt": "In this fictional fixture, sipa means the requested item.",
          "targetCapabilityIds": ["portable-request-item"],
          "supportingCapabilityIds": [],
          "communicationMode": "reading",
          "usage": "teaching",
          "assessmentEligible": false,
          "evidenceEligibility": "none",
          "supportLevel": "high",
          "hints": [],
          "feedbackContrasts": [],
          "retryPolicy": { "maxAttempts": 1, "canSkip": false },
          "accessibility": { "instruction": "The same context is available as selectable text." },
          "assetIds": ["fixture-card"],
          "text": "sipa is an invented token used only to test the universal course contract."
        },
        {
          "schemaVersion": 1,
          "id": "portable-symbol-choice",
          "version": "1.0.0",
          "rendererType": "script_recognition",
          "phase": "notice",
          "instruction": "Choose the authored item token.",
          "prompt": "Which token means the fixture item?",
          "targetCapabilityIds": ["portable-request-item"],
          "supportingCapabilityIds": [],
          "communicationMode": "reading",
          "usage": "teaching",
          "assessmentEligible": false,
          "evidenceEligibility": "none",
          "supportLevel": "high",
          "hints": ["The model used sipa."],
          "feedbackContrasts": [{ "when": "wave", "feedback": "wave is an authored distractor; sipa is the fixture item." }],
          "retryPolicy": { "maxAttempts": 2, "canSkip": false },
          "accessibility": { "instruction": "Two text choices are announced in order." },
          "assetIds": [],
          "choices": [
            { "id": "sipa", "text": "sipa" },
            { "id": "wave", "text": "wave" }
          ],
          "acceptedChoiceIds": ["sipa"]
        },
        {
          "schemaVersion": 1,
          "id": "portable-recall",
          "version": "1.0.0",
          "rendererType": "type_response",
          "phase": "retrieve",
          "instruction": "Type the fixture item token.",
          "prompt": "Recall the token meaning the item.",
          "targetCapabilityIds": ["portable-request-item"],
          "supportingCapabilityIds": [],
          "communicationMode": "written-production",
          "usage": "practice",
          "assessmentEligible": false,
          "evidenceEligibility": "practice",
          "supportLevel": "medium",
          "hints": ["It begins with si."],
          "feedbackContrasts": [{ "when": "other", "feedback": "Compare your response with the authored token sipa." }],
          "retryPolicy": { "maxAttempts": 2, "canSkip": true },
          "accessibility": { "instruction": "Enter a short lowercase text response." },
          "assetIds": [],
          "acceptedResponses": ["sipa"]
        },
        {
          "schemaVersion": 1,
          "id": "portable-build-request",
          "version": "1.0.0",
          "rendererType": "order_phrase",
          "phase": "produce",
          "instruction": "Order the two fixture tokens.",
          "prompt": "Build the neutral request.",
          "targetCapabilityIds": ["portable-request-item"],
          "supportingCapabilityIds": [],
          "communicationMode": "written-production",
          "usage": "practice",
          "assessmentEligible": false,
          "evidenceEligibility": "practice",
          "supportLevel": "fading",
          "hints": ["The item token comes first."],
          "feedbackContrasts": [{ "when": "na sipa", "feedback": "The authored fixture order is sipa na." }],
          "retryPolicy": { "maxAttempts": 2, "canSkip": true },
          "accessibility": { "instruction": "The tokens can be reordered with keyboard controls." },
          "assetIds": [],
          "tokens": ["sipa", "na"],
          "acceptedOrders": [["sipa", "na"]]
        },
        {
          "schemaVersion": 1,
          "id": "portable-roleplay",
          "version": "1.0.0",
          "rendererType": "mini_roleplay",
          "phase": "perform",
          "instruction": "Complete the authored one-turn fixture exchange.",
          "prompt": "Request the fixture item from the attendant.",
          "targetCapabilityIds": ["portable-request-item"],
          "supportingCapabilityIds": [],
          "communicationMode": "spoken-interaction",
          "usage": "assessment",
          "assessmentEligible": true,
          "evidenceEligibility": "demonstration",
          "supportLevel": "bounded",
          "hints": ["Use the authored request if needed."],
          "feedbackContrasts": [{ "when": "goal-not-observed", "feedback": "Try the request again or use the text alternative." }],
          "retryPolicy": { "maxAttempts": 2, "canSkip": true },
          "accessibility": { "instruction": "A typed response may replace microphone input.", "nonAudioAlternative": "Type sipa na." },
          "assetIds": [],
          "scenarioId": "portable-service-scenario",
          "rubric": { "criteria": ["The request intent is observed"], "minimumMet": 1 }
        },
        {
          "schemaVersion": 1,
          "id": "portable-checkpoint",
          "version": "1.0.0",
          "rendererType": "checkpoint_item",
          "phase": "perform",
          "instruction": "Complete a varied fixture prompt.",
          "prompt": "Make the same request when the item card changes position.",
          "targetCapabilityIds": ["portable-request-item"],
          "supportingCapabilityIds": [],
          "communicationMode": "written-production",
          "usage": "assessment",
          "assessmentEligible": true,
          "evidenceEligibility": "demonstration",
          "supportLevel": "bounded",
          "hints": ["One authored hint is permitted."],
          "feedbackContrasts": [{ "when": "request-missing", "feedback": "Include both authored fixture tokens." }],
          "retryPolicy": { "maxAttempts": 2, "canSkip": false },
          "accessibility": { "instruction": "Respond with the two-token request." },
          "assetIds": [],
          "rubric": { "criteria": ["Includes sipa", "Includes na"], "minimumMet": 2 }
        },
        {
          "schemaVersion": 1,
          "id": "portable-review",
          "version": "1.0.0",
          "rendererType": "type_response",
          "phase": "revisit",
          "instruction": "Retrieve the request after the authored delay.",
          "prompt": "Write the fixture request without the model.",
          "targetCapabilityIds": ["portable-request-item"],
          "supportingCapabilityIds": [],
          "communicationMode": "written-production",
          "usage": "review",
          "assessmentEligible": true,
          "evidenceEligibility": "retention",
          "supportLevel": "low",
          "hints": [],
          "feedbackContrasts": [{ "when": "other", "feedback": "Return to the retrieval activity before retrying later." }],
          "retryPolicy": { "maxAttempts": 1, "canSkip": true },
          "accessibility": { "instruction": "Enter a short lowercase text response." },
          "assetIds": [],
          "acceptedResponses": ["sipa na"]
        },
        {
          "schemaVersion": 1,
          "id": "portable-review-variation",
          "version": "1.0.0",
          "rendererType": "type_response",
          "phase": "revisit",
          "instruction": "Retrieve the request from a changed authored cue after the delay.",
          "prompt": "The fixture attendant is waiting. Write the request from memory.",
          "targetCapabilityIds": ["portable-request-item"],
          "supportingCapabilityIds": [],
          "communicationMode": "written-production",
          "usage": "review",
          "assessmentEligible": true,
          "evidenceEligibility": "retention",
          "supportLevel": "low",
          "hints": [],
          "feedbackContrasts": [{ "when": "other", "feedback": "Return to the retrieval activity before retrying later." }],
          "retryPolicy": { "maxAttempts": 1, "canSkip": true },
          "accessibility": { "instruction": "Enter a short lowercase text response." },
          "assetIds": [],
          "acceptedResponses": ["sipa na"]
        }
      ],
      "newMaterial": ["sipa", "na"],
      "recycledMaterial": [],
      "feedbackRetryBehavior": "Give the authored contrast, then return to the nearest lower-support activity.",
      "completionCondition": {
        "type": "all-required-activities",
        "requiredActivityIds": [
          "portable-context",
          "portable-symbol-choice",
          "portable-recall",
          "portable-build-request",
          "portable-roleplay",
          "portable-checkpoint"
        ]
      },
      "safeResumeActivityIds": [
        "portable-context",
        "portable-symbol-choice",
        "portable-recall",
        "portable-build-request",
        "portable-roleplay",
        "portable-checkpoint",
        "portable-review",
        "portable-review-variation"
      ],
      "assetIds": ["fixture-card"]
    }
  ],
  "supportFadingPlan": ["model", "constrained-choice", "cued-recall", "varied-transfer"],
  "checkpointActivityIds": ["portable-roleplay", "portable-checkpoint"],
  "reviewActivityIds": ["portable-review", "portable-review-variation"],
  "interruptionResume": {
    "boundary": "activity",
    "behavior": "Resume before the next incomplete activity and never inside an attempt."
  },
  "offline": {
    "supported": true,
    "unavailableActivityIds": ["portable-roleplay"]
  },
  "accessibilityAlternatives": ["Typed response replaces the guided spoken turn."],
  "assets": [
    {
      "id": "fixture-card",
      "type": "image",
      "path": "assets/fixture-card.svg",
      "description": "A neutral geometric card used only to prove local asset resolution."
    }
  ],
  "reviewerRefs": ["fixture-schema-review"],
  "sourceRefs": ["https://example.invalid/glidelingo/portability-fixture"]
}
