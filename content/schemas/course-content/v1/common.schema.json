{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glidelingo.app/schemas/course-content/v1/common.schema.json",
  "title": "GlideLingo course content common definitions",
  "$defs": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "locale": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*|x(?:-[A-Za-z0-9]{1,8})+)$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "nonEmptyIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "communicationMode": {
      "enum": [
        "listening",
        "reading",
        "spoken-production",
        "written-production",
        "spoken-interaction",
        "written-interaction",
        "mediation",
        "repair"
      ]
    },
    "communicationModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/communicationMode"
      },
      "uniqueItems": true
    },
    "localAssetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "reviewStatus": {
      "enum": ["pending", "approved", "rejected"]
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "evidence"],
      "properties": {
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "reviewer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
