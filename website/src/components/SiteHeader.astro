---
interface Props {
  activePage?: 'blog';
}

const { activePage } = Astro.props;
const onHomepage = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand-link" href="/" aria-label="GlideLingo home">
      <span class="brand-lockup">
        <img class="brand-symbol" src="/brand/glidelingo-bird-black.svg" width="102" height="101" alt="" />
        <span class="brand-name">GlideLingo</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href={onHomepage ? '#pricing' : '/#pricing'}>Pricing</a>
      <a href="/blog/" aria-current={activePage === 'blog' ? 'page' : undefined}>Blog</a>
      <a href={onHomepage ? '#demo' : '/#demo'}>How it works</a>
    </nav>
  </div>
</header>
