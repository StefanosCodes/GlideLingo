---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — GlideLingo"
  description="The page you were looking for could not be found."
  canonicalPath="/404"
  noindex
>
  <main class="not-found" id="main-content">
    <a class="brand-link" href="/" aria-label="GlideLingo home">
      <span class="brand-lockup">
        <img class="brand-symbol" src="/brand/glidelingo-bird-black.svg" width="102" height="101" alt="" />
        <span class="brand-name">GlideLingo</span>
      </span>
    </a>
    <img class="not-found-bird" src="/brand/glidelingo-bird-black.svg" width="102" height="101" alt="" />
    <p class="eyebrow">404</p>
    <h1>This page flew off course.</h1>
    <p>There is nothing here, but your next lesson is still waiting.</p>
    <a class="button button-primary" href="/">Return home</a>
  </main>
</BaseLayout>
