---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveMacDownload } from '../lib/download-config.mjs';

const download = resolveMacDownload(process.env);
const productVideo = {
  captions: '/videos/glidelingo-product-walkthrough.vtt',
  poster: '/images/product-home.png',
  src: '/videos/glidelingo-product-walkthrough.mp4',
  webm: '/videos/glidelingo-product-walkthrough.webm',
};
const productVideoReady =
  existsSync(resolve('public/videos/glidelingo-product-walkthrough.mp4')) &&
  existsSync(resolve('public/videos/glidelingo-product-walkthrough.webm')) &&
  existsSync(resolve('public/videos/glidelingo-product-walkthrough.vtt'));
const description =
  'GlideLingo redesigns language learning around clear lessons, focused review, and a calm weekly rhythm you can keep.';
---

<BaseLayout title="GlideLingo — Language learning, redesigned" description={description}>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand-link" href="/" aria-label="GlideLingo home">
        <span class="brand-lockup">
          <img class="brand-symbol" src="/brand/glidelingo-bird-black.svg" width="102" height="101" alt="" />
          <span class="brand-name">GlideLingo</span>
        </span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#pricing">Pricing</a>
        <a href="#demo">How it works</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero shell" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <h1 id="hero-heading">Learn the language. <span class="hero-accent">Enter the world.</span></h1>
        <p class="hero-lede">
          Build the skills and confidence to stop practicing from the sidelines and start joining real conversations.
        </p>
        <div class="hero-actions" data-download-state={download.available ? 'available' : 'unavailable'}>
          {
            download.available ? (
              <a
                class="button button-primary"
                href={download.downloadUrl}
                aria-label={`Download GlideLingo ${download.version} for Mac`}
              >
                Download
                <svg class="button-platform-icon button-apple-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.79 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09ZM12.03 7.25C11.88 5.02 13.69 3.18 15.77 3c.29 2.58-2.34 4.5-3.74 4.25Z"></path>
                </svg>
              </a>
            ) : (
              <span class="button button-primary button-inactive" aria-disabled="true">
                Download
                <svg class="button-platform-icon button-apple-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.79 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09ZM12.03 7.25C11.88 5.02 13.69 3.18 15.77 3c.29 2.58-2.34 4.5-3.74 4.25Z"></path>
                </svg>
              </span>
            )
          }
        </div>
      </div>
    </section>

    <section class="product-showcase shell" id="demo" aria-labelledby="demo-heading">
      <div class="demo-intro">
        <p class="eyebrow">How it works</p>
        <h2 id="demo-heading">See the learning rhythm in motion.</h2>
        <p>Watch a short tour from your first lesson to focused review.</p>
      </div>
      <figure class="product-frame" data-video-state={productVideoReady ? 'ready' : 'awaiting-source'}>
        <div class="window-bar" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="demo-player">
          <video
            controls={productVideoReady}
            data-autoplay-when-visible={productVideoReady || undefined}
            loop={productVideoReady}
            muted={productVideoReady}
            playsinline
            poster={productVideo.poster}
            preload="metadata"
            aria-label="GlideLingo product walkthrough"
          >
            {
              productVideoReady && (
                <>
                  <source src={productVideo.webm} type="video/webm" />
                  <source src={productVideo.src} type="video/mp4" />
                  <track
                    kind="captions"
                    label="English"
                    src={productVideo.captions}
                    srclang="en"
                  />
                </>
              )
            }
            Your browser does not support HTML video.
          </video>
          {
            !productVideoReady && (
              <div class="demo-status" aria-label="Product walkthrough video coming soon">
                <span class="demo-play" aria-hidden="true">▶</span>
                <span>
                  <strong>Product walkthrough</strong>Video coming soon
                </span>
              </div>
            )
          }
        </div>
        <figcaption>
          {productVideoReady
            ? 'A focused tour of lessons, practice, and review inside GlideLingo.'
            : 'The player is ready for the final first-party product walkthrough.'}
        </figcaption>
      </figure>
    </section>

    <section class="pricing shell" id="pricing" aria-labelledby="pricing-heading">
      <div class="pricing-intro">
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-heading">Start free. Go further with Pro.</h2>
        <p>Choose the plan that fits where you are. Upgrade whenever.</p>
      </div>

      <div class="pricing-grid">
        <article class="pricing-card" aria-labelledby="free-plan-heading">
          <div class="pricing-card-heading">
            <h3 id="free-plan-heading">Free</h3>
            <p class="plan-price"><span>$0</span><span>forever</span></p>
          </div>
          <p class="plan-summary">Build your foundation and experience the GlideLingo learning rhythm.</p>
          <ul class="plan-features">
            <li>Guided starter lessons</li>
            <li>Essential review</li>
            <li>Progress tracking</li>
          </ul>
        </article>

        <article class="pricing-card pricing-card-featured" aria-labelledby="pro-plan-heading">
          <div class="pricing-card-heading">
            <h3 id="pro-plan-heading">Pro</h3>
            <p class="plan-price"><span>$19.99</span><span>per month</span></p>
          </div>
          <p class="plan-billing">Billed monthly. Cancel anytime.</p>
          <p class="plan-summary">Keep moving from your first lessons toward confident, real conversation.</p>
          <ul class="plan-features">
            <li>Complete learning path</li>
            <li>Unlimited review and practice</li>
            <li>Speaking and conversation practice</li>
            <li>Complete progress insights</li>
          </ul>
        </article>
      </div>
    </section>

  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <a class="brand-link footer-brand" href="/" aria-label="GlideLingo home">
        <span class="brand-lockup">
          <img class="brand-symbol" src="/brand/glidelingo-bird-black.svg" width="102" height="101" alt="" />
          <span class="brand-name">GlideLingo</span>
        </span>
      </a>
      <p>© {new Date().getFullYear()} GlideLingo</p>
      <a href="https://github.com/StefanosCodes/GlideLingo/releases">GitHub releases</a>
    </div>
  </footer>
  <script src="/scripts/video-player.js" defer is:inline></script>
</BaseLayout>
