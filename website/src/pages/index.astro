---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveMacDownload } from '../lib/download-config.mjs';

const download = resolveMacDownload(process.env);
const productVideo = {
  captions: '/videos/glidelingo-product-walkthrough.vtt',
  poster: '/images/product-home.png',
  src: '/videos/glidelingo-product-walkthrough.mp4',
  webm: '/videos/glidelingo-product-walkthrough.webm',
};
const productVideoReady =
  existsSync(resolve('public/videos/glidelingo-product-walkthrough.mp4')) &&
  existsSync(resolve('public/videos/glidelingo-product-walkthrough.webm')) &&
  existsSync(resolve('public/videos/glidelingo-product-walkthrough.vtt'));
const releaseFallbackUrl = 'https://github.com/StefanosCodes/GlideLingo/releases';
const startHref = download.available ? download.downloadUrl : releaseFallbackUrl;
const primaryDownloadLabel = download.available ? 'Download for macOS' : 'View releases';
const platformAvailability = download.available
  ? 'Universal for Apple silicon and Intel Macs'
  : 'Available for macOS';
const description =
  'GlideLingo helps you learn a language, speak with confidence, and keep progressing toward mastery.';
---

<BaseLayout
  title="GlideLingo | Learn a language. Speak with confidence."
  description={description}
  socialImageAlt="The GlideLingo language-learning app home screen"
>
  {
    download.available && (
      <aside class="launch-banner" aria-label="Product announcement">
        <div class="shell launch-banner-inner">
          <span>GlideLingo for macOS is now available. <span aria-hidden="true">🎉</span></span>
          <a href={download.downloadUrl}>
            Download for macOS <span aria-hidden="true">↗</span>
          </a>
        </div>
      </aside>
    )
  }
  <SiteHeader primaryCtaHref={startHref} primaryCtaIcon="apple" primaryCtaLabel={primaryDownloadLabel} />

  <main id="main-content">
    <section class="hero shell" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <h1 id="hero-heading">Learn a language. <span class="hero-accent">Speak with confidence.</span></h1>
        <p class="hero-lede">
          GlideLingo is a complete language-learning platform built to take you from your first lesson to real
          conversation, and keep you progressing toward mastery.
        </p>
        <div class="hero-actions" data-download-state={download.available ? 'available' : 'unavailable'}>
          <a class="button button-primary" href={startHref}>
            {primaryDownloadLabel}
            <svg class="button-platform-icon button-apple-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.79 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09ZM12.03 7.25C11.88 5.02 13.69 3.18 15.77 3c.29 2.58-2.34 4.5-3.74 4.25Z"></path>
            </svg>
          </a>
          <a class="button button-secondary" href="#demo">See how it works</a>
        </div>
        <p class="hero-meta">Free to start <span aria-hidden="true">·</span> {platformAvailability}</p>
      </div>
    </section>

    <section class="product-showcase shell" id="demo" aria-labelledby="demo-heading">
      <div class="demo-intro">
        <p class="eyebrow">How it works</p>
        <h2 id="demo-heading">See how speaking starts.</h2>
        <p>See how GlideLingo moves you from guided learning to speaking practice and focused review.</p>
      </div>
      <figure class="product-frame" data-video-state={productVideoReady ? 'ready' : 'awaiting-source'}>
        <div class="window-bar" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="demo-player">
          <video
            controls={productVideoReady}
            data-autoplay-when-visible={productVideoReady || undefined}
            loop={productVideoReady}
            muted={productVideoReady}
            playsinline
            poster={productVideo.poster}
            preload="metadata"
            aria-label="GlideLingo product walkthrough"
          >
            {
              productVideoReady && (
                <>
                  <source src={productVideo.webm} type="video/webm" />
                  <source src={productVideo.src} type="video/mp4" />
                  <track
                    kind="captions"
                    label="English"
                    src={productVideo.captions}
                    srclang="en"
                  />
                </>
              )
            }
            Your browser does not support HTML video.
          </video>
          {
            !productVideoReady && (
              <div class="demo-status" aria-label="Product walkthrough video coming soon">
                <span class="demo-play" aria-hidden="true">▶</span>
                <span>
                  <strong>Product walkthrough</strong>Video coming soon
                </span>
              </div>
            )
          }
        </div>
        <figcaption>
          {productVideoReady
            ? 'A focused tour of lessons, practice, and review inside GlideLingo.'
            : 'The player is ready for the final first-party product walkthrough.'}
        </figcaption>
      </figure>
      <div class="product-actions">
        <a class="button button-primary" href={startHref}>Start speaking</a>
      </div>
    </section>

    <section class="pricing shell" id="pricing" aria-labelledby="pricing-heading">
      <div class="pricing-intro">
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-heading">Start with Starter. Keep speaking with Professional.</h2>
        <p>Choose the plan that fits where you are. Upgrade whenever.</p>
      </div>

      <div class="pricing-grid">
        <article class="pricing-card" aria-labelledby="starter-plan-heading">
          <div class="pricing-card-heading">
            <div class="plan-name">
              <img src="/brand/glidelingo-bird-black.svg" width="102" height="101" alt="" />
              <h3 id="starter-plan-heading">Starter</h3>
            </div>
            <p class="plan-price"><span>$0</span><span>forever</span></p>
          </div>
          <p class="plan-audience">For new learners</p>
          <p class="plan-summary">Build your foundation and experience the GlideLingo learning rhythm.</p>
          <p class="plan-includes">What’s included</p>
          <ul class="plan-features">
            <li>Guided starter lessons</li>
            <li>Essential review</li>
            <li>Progress tracking</li>
            <li>Weekly learning rhythm</li>
          </ul>
          <p class="plan-note">Build a steady habit before deciding whether you need more.</p>
          <a class="button button-primary plan-cta" href={startHref}>Start free</a>
        </article>

        <article class="pricing-card pricing-card-featured" aria-labelledby="professional-plan-heading">
          <div class="pricing-card-heading">
            <div class="plan-name">
              <img src="/brand/glidelingo-bird-black.svg" width="102" height="101" alt="" />
              <h3 id="professional-plan-heading">Professional</h3>
            </div>
            <p class="plan-price"><span>$19.99</span><span>per month</span></p>
          </div>
          <p class="plan-billing">Billed monthly. Cancel anytime.</p>
          <p class="plan-audience">For committed learners</p>
          <p class="plan-summary">Keep moving from your first lessons toward confident, real conversation.</p>
          <p class="plan-includes">What’s included</p>
          <ul class="plan-features">
            <li>Everything in Starter</li>
            <li>Complete learning path</li>
            <li>Unlimited review and practice</li>
            <li>Speaking and conversation practice</li>
            <li>Complete progress insights</li>
          </ul>
          <p class="plan-note">More room to practice, speak, and keep progressing at your pace.</p>
          <a class="button button-primary plan-cta" href={startHref}>Go Professional</a>
        </article>
      </div>
    </section>

    <section class="final-cta shell" aria-labelledby="final-cta-heading">
      <div class="final-cta-inner">
        <h2 id="final-cta-heading">Ready to speak a new language?</h2>
        <p>Start learning, start speaking, and keep progressing toward real mastery.</p>
        <a class="button button-primary" href={startHref}>Start speaking</a>
      </div>
    </section>
  </main>

  <SiteFooter />
  <script src="/scripts/video-player.js" defer is:inline></script>
</BaseLayout>
